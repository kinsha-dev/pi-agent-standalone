;; pi-sandbox.sb — macOS Seatbelt profile confining the `pi` coding agent to this
;; project folder. pi has NO built-in filesystem restriction, so we wrap its whole
;; process (incl. its bash/edit/write tools) in this sandbox.
;;
;; Policy:
;;   • WRITES allowed ONLY inside the project dir (+ temp + /dev sinks).
;;   • READS allowed for the OS runtime pi needs to execute (system libs, node)
;;     and the project dir — but NOT other user folders (~/Documents, ~/.ssh,
;;     sibling projects, etc.).
;;   • Network stays open (pi needs the OpenRouter/LLM API).
;;
;; Invoke with:  sandbox-exec -D DIR=<abs project path> -f pi-sandbox.sb <cmd>

(version 1)
(deny default)

;; --- process / system basics needed to run node ---
(allow process-fork)
(allow process-exec)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm)
(allow system-socket)
(allow file-ioctl)
(allow file-read-metadata)

;; --- network: OUTBOUND ONLY (LLM API access) ---
;; Inbound/bind are deliberately NOT granted: the agent only needs to *reach* the
;; LLM API, never to listen. Allowing inbound/bind would let a prompt-injected agent
;; open a local listener (reverse shell / C2 / on-host exfil server) — an escalation
;; path out of "just talks to the API".
(allow network-outbound)

;; --- reads: OS runtime + the project only ---
(allow file-read*
    (subpath "/usr")
    (subpath "/bin")
    (subpath "/sbin")
    (subpath "/opt")
    (subpath "/System")
    (subpath "/Library")
    (subpath "/Applications")
    (subpath "/private/var")
    (subpath "/private/tmp")
    (subpath "/private/etc")
    (subpath "/dev")
    (literal "/")
    (subpath (param "DIR"))
    (subpath (param "PIHOME"))    ;; pi's own runtime dir (~/.pi) — binaries/auth/config
    (literal (param "GITCONFIG"))      ;; ~/.gitconfig (read-only) — git needs it for identity/helper
    (subpath (param "GITCONFIGDIR")))  ;; ~/.config/git (read-only)
    ;; NOTE: ~/.pm2 is intentionally NOT readable. The PM2 "God" daemon runs OUTSIDE
    ;; this sandbox; access to ~/.pm2 (its RPC socket / dump.pm2) would let the confined
    ;; agent command that daemon to spawn unsandboxed processes — a full sandbox escape.

;; --- writes: project dir + pi runtime + temp + dev sinks ONLY ---
;; ~/.pm2 write is intentionally removed: writing dump.pm2 / talking to the daemon
;; socket is an escape path to unsandboxed code execution (see read policy above).
(allow file-write*
    (subpath (param "DIR"))
    (subpath (param "PIHOME"))    ;; ~/.pi/agent/bin (fd/ripgrep), sessions, auth
    (subpath "/private/tmp")
    (subpath "/private/var/folders")
    (literal "/dev/null")
    (literal "/dev/tty")
    (literal "/dev/dtracehelper")
    (literal "/dev/random")
    (literal "/dev/urandom"))
